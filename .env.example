# Токен сообщества ВКонтакте (Сообщество -> Управление -> Работа с API -> Ключи доступа -> Создать ключ)
# Обязательные права:
#   1) Доступ к управлению сообществом (нужен для LongPoll)
#   2) Доступ к сообщениям сообщества
VK_TOKEN=vk1.a.your_token_here

# ID администраторов ВКонтакте через запятую (например, 12345678,87654321)
# Узнать свой ID можно отправив команду /myid боту
ADMIN_IDS=12345678

# Необязательные настройки группы (если не указаны, бот определит их автоматически)
# VK_GROUP_ID=123456789
# VK_GROUP_DOMAIN=my_barbershop

# Необязательные настройки салона (по умолчанию берутся из config.py)
# BOOKING_URL=https://mst.link/boris_gafurov/price?cid=vddrm99a3uu0o9cgk508u6uctp
# SALON_ADDRESS=Саратов, ул. имени Е.И. Пугачёва, 110
# SALON_LATITUDE=51.536988
# SALON_LONGITUDE=46.013896
# WORK_HOURS=Вторник и суббота: 10:00–19:00
# REFERRAL_REWARD_AMOUNT=300
